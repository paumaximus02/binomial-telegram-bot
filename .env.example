TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local dev: http://127.0.0.1:8000
# Render/cloud: https://your-binomial-pricer.onrender.com
API_BASE_URL=https://your-binomial-pricer.onrender.com

# Comma-separated Telegram user IDs allowed to use the bot in private chat
# Find your ID: message @userinfobot on Telegram, or send /whoami to the bot
ALLOWED_USER_IDS=123456789

# Comma-separated group chat IDs where anyone in the group may use the bot
# Add the bot to the group, send /whoami there, and copy the "Group chat ID"
ALLOWED_GROUP_IDS=-1001234567890
